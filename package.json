{
  "name": "dpviewlayer",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.0.10",
  "publisher": "yxfangcs",
  "license": "MIT",
  "keywords": [
    "viewlayer",
    "dpviewlayer",
    "GIS",
    "raster",
    "layer",
    "GeoTIFF",
    "TIF",
    "image viewer",
    "openlayer",
    "QGIS",
    "影像",
    "栅格",
    "图层"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onCommand:viewLayer.openInNewView",
    "onCommand:viewLayer.addAsLayer",
    "onCommand:viewLayer.newView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "viewLayer.openInNewView",
        "title": "%command.openInNewView.title%",
        "icon": "$(window)"
      },
      {
        "command": "viewLayer.addAsLayer",
        "title": "%command.addAsLayer.title%",
        "icon": "$(symbol-color)"
      },
      {
        "command": "viewLayer.newView",
        "title": "%command.newView.title%",
        "icon": "$(split-horizontal)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "viewLayer.openInNewView",
          "when": "resourceExtname == .png || resourceExtname == .jpg || resourceExtname == .jpeg || resourceExtname == .tif || resourceExtname == .tiff || resourceExtname == .bmp",
          "group": "viewLayer@1"
        },
        {
          "command": "viewLayer.addAsLayer",
          "when": "resourceExtname == .png || resourceExtname == .jpg || resourceExtname == .jpeg || resourceExtname == .tif || resourceExtname == .tiff || resourceExtname == .bmp",
          "group": "viewLayer@2"
        }
      ],
      "editor/title/context": [
        {
          "command": "viewLayer.openInNewView",
          "when": "resourceExtname == .png || resourceExtname == .jpg || resourceExtname == .jpeg || resourceExtname == .tif || resourceExtname == .tiff || resourceExtname == .bmp",
          "group": "viewLayer@1"
        },
        {
          "command": "viewLayer.addAsLayer",
          "when": "resourceExtname == .png || resourceExtname == .jpg || resourceExtname == .jpeg || resourceExtname == .tif || resourceExtname == .tiff || resourceExtname == .bmp",
          "group": "viewLayer@2"
        }
      ],
      "commandPalette": [
        {
          "command": "viewLayer.openInNewView"
        },
        {
          "command": "viewLayer.addAsLayer"
        },
        {
          "command": "viewLayer.newView"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:icon && npm run build:webview && npm run build:geotiff && tsc -p ./",
    "bump": "npm version patch --no-git-tag-version",
    "build:icon": "node scripts/build-icon.mjs",
    "build:webview": "esbuild media/src/main.js --bundle --outfile=media/main.js --format=iife",
    "build:geotiff": "mkdir -p out/vendor && esbuild node_modules/geotiff/dist-module/geotiff.js --bundle --platform=node --format=cjs --outfile=out/vendor/geotiff.cjs",
    "compile": "npm run bump && npm run build:icon && npm run build:webview && npm run build:geotiff && tsc -p ./",
    "package": "npx --yes @vscode/vsce package --allow-missing-repository && node scripts/verify-vsix.mjs",
    "smoke": "node scripts/smoke/run.mjs && node scripts/smoke/invert-unit.mjs && node scripts/smoke/stretch-unit.mjs && node scripts/smoke/crs-run.mjs",
    "verify:vsix": "node scripts/verify-vsix.mjs",
    "smoke:crs": "node scripts/smoke/crs-run.mjs",
    "smoke:stretch": "node scripts/smoke/stretch-unit.mjs",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.1",
    "puppeteer-core": "^24.43.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "geotiff": "^3.0.5",
    "ol": "^10.9.0",
    "proj4": "^2.20.9",
    "utif2": "^4.1.0"
  },
  "icon": "media/icon.png"
}
